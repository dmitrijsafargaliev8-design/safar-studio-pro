<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Blind A/B Lab</title><style>body{margin:0;background:#0e0f12;color:#e4e6eb;font:16px system-ui;display:grid;min-height:100dvh;place-content:center}main{padding:24px;width:min(78vw,520px)}small{color:#e5a93c;letter-spacing:.15em}h1{letter-spacing:-.07em;font-size:clamp(40px,9vw,66px);margin:15px 0}button{font:16px system-ui;background:#202125;color:inherit;border:1px solid #46464b;border-radius:5px;cursor:pointer;padding:12px 22px}button[aria-pressed=true]{background:#e5a93c;color:#191511}p{color:#b5b5ba;line-height:1.5}input{width:100%;accent-color:#e5a93c;margin:16px 0}output{font-family:monospace}</style></head><body><main><small id="brand">SAFAR STUDIO</small><h1>Blind A/B Lab</h1><p id="note">Два мастера при равной громкости. Выбери на слух.</p><button id="a">A</button> <button id="b">B</button> <button id="stop">Пауза</button><input type="range" id="seek" min="0" max="1" value="0" step=".001" aria-label="Позиция"><button id="vote">Выбрать эту версию</button><p id="res" role="status"></p></main><script>/*__ENGINE__*/</script><script>
const $=id=>document.getElementById(id);let pair=null,current=0,token=new URLSearchParams(location.search).get('pair'),busy=false,clock=0,active=null,stopped=0;
async function init(){if(pair)return;const r=await fetch('/api/listen/'+encodeURIComponent(token));const d=await r.json();if(!r.ok)throw Error(d.error);$('brand').textContent=d.brand||'SAFAR STUDIO';await audioOn();const buffs=await Promise.all(d.sources.map(async u=>{const r=await fetch(u);if(!r.ok)throw Error('Файл недоступен');return ac.decodeAudioData(await r.arrayBuffer())}));rate=ac.sampleRate;const n=Math.min(...buffs.map(b=>b.length));const ch=buffs.map(b=>[b.getChannelData(0).slice(0,n),b.getChannelData(Math.min(1,b.numberOfChannels-1)).slice(0,n)]);pair=matched(ch[0],ch[1]);pair.order=crypto.getRandomValues(new Uint8Array(1))[0]&1;pair.duration=n/rate;$('note').textContent='Обе версии · '+pair.lufs.toFixed(1)+' LUFS-I'}
function position(){return active?Math.min(pair.duration,ac.currentTime-clock):stopped}
function pause(){stopped=position();if(active){active.onended=null;active.stop();active.disconnect();active=null}}
async function choose(i){if(busy)return;busy=true;try{await init();pause();if(stopped>=pair.duration-.02)stopped=0;current=i;active=ac.createBufferSource();active.buffer=bufferFor(pair.data[i^pair.order]);active.connect(ac.destination);clock=ac.currentTime-stopped;active.start(0,stopped);active.onended=()=>{active=null;stopped=0};$('a').setAttribute('aria-pressed',i===0);$('b').setAttribute('aria-pressed',i===1)}catch(e){$('res').textContent=e.message}finally{busy=false}}
$('a').onclick=()=>choose(0);$('b').onclick=()=>choose(1);$('stop').onclick=pause;$('vote').onclick=()=>{if(pair)$('res').textContent='Выбрана '+(current?'B':'A')+' · исходный мастер '+((current^pair.order)+1)};$('seek').oninput=()=>{if(!pair)return;const run=!!active;pause();stopped=+$('seek').value*pair.duration;if(run)choose(current)};setInterval(()=>{if(pair&&active)$('seek').value=position()/pair.duration},150);document.onkeydown=e=>{if(e.target.tagName==='INPUT')return;if(e.code==='KeyA')choose(0);if(e.code==='KeyB')choose(1);if(e.code==='Space'){e.preventDefault();if(active)pause();else choose(current)}};
</script></body></html>
