<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0e0f12"><title>SAFAR STUDIO · Mixing console</title>
<style>/*__CSS__*/</style></head><body>
<header><a href="#desk" class="brand" aria-label="SAFAR STUDIO"><i class="mark" aria-hidden="true"><b></b><b></b><b></b><b></b></i>SAFAR<span>STUDIO</span></a>
<nav><button data-home class="navActive">Консоль</button><button id="sessions">Сессии</button><button data-plans>Тарифы</button></nav><button id="wallet" class="wallet" data-plans><i></i><span id="balance">30</span> CR</button><button id="account" class="account" aria-label="Аккаунт">S</button></header>
<main id="desk"><div class="intro"><div><div class="eyebrow"><i class="pilot"></i><span id="sourceLabel">ЛОКАЛЬНАЯ СЕССИЯ</span><span class="slash">/</span> MULTITRACK</div><h1 id="songName">Ночная смена<span>.</span></h1><div id="subline" class="subline">SAFAR <b>·</b> Синтезированный демо-тейк</div></div>
<div class="introActions"><button class="secondary" id="import">↑ &nbsp; Импорт аудио</button><button class="primary" id="playTop"><strong>▶</strong> Слушать</button></div></div>
<div class="desk">
<aside class="panel passport"><div class="cap"><span class="sectionNo">01</span><h2>Song Passport</h2><span class="terminal">INPUT</span></div><div class="pad">
<label class="lab" for="brief">Описание трека</label><textarea id="brief" rows="3" maxlength="3000">Ночной бум-бэп. Сухой близкий голос, тёплое пианино и тяжёлый низ.</textarea>
<label class="lab" for="lyrics">Текст</label><textarea id="lyrics" rows="4" maxlength="16000">[Verse]
Через шум я слышу город
[Hook]
До рассвета держим свет</textarea>
<label class="lab" for="model">Движок</label><select id="model"><option value="sketch">Sketch · ACE-Step Turbo</option><option value="studio">Studio · ACE-Step 1.5 XL</option></select>
<div class="pair"><label class="lab">Темп, BPM<input type="number" id="bpm" value="88" min="45" max="220"></label><label class="lab">Тональность<select id="key"><option value="Dm">D min</option><option value="Am">A min</option><option value="Cm">C min</option><option value="Fm">F min</option><option value="Gm">G min</option></select></label></div>
<details><summary>Голос и Artist LoRA</summary><label class="lab">Характер<select id="voice"><option>Близкий баритон</option><option>Мягкий тенор</option><option>Хриплая подача</option><option>Инструментал</option></select></label><label class="lab">Язык<select id="language"><option value="ru">Русский</option><option value="uk">Українська</option><option value="en">English</option></select></label><label class="lab">Artist LoRA<select id="lora"><option value="">Исходная модель</option></select></label><label class="lab">Длительность GPU, сек<input id="duration" type="number" value="40" min="12" max="600"></label><button class="textBtn" id="train">Обучить Artist LoRA ↗</button></details>
<button id="generate" class="primary full">Создать эскиз <em>10 CR</em></button><button class="assist" id="ar">✧ &nbsp; A&amp;R · разобрать бриф</button></div></aside>
<section class="center"><article class="panel wavePanel"><div class="cap"><span class="sectionNo">02</span><h2>Аранжировка</h2><span class="terminal amber" id="gridTitle">GRID 1 BAR</span></div>
<div class="transport"><button class="icon" id="rew" aria-label="В начало">|◀︎</button><button class="icon playMini" id="play" aria-label="Воспроизвести">▶</button><button class="icon" id="loop" aria-label="Повторить выделение" aria-pressed="false">↻</button><strong id="time">00:00.0</strong><span class="dur" id="total"></span><span class="tempo" id="tempoTag">88 BPM</span></div>
<div class="timeline"><canvas id="wave" tabindex="0" role="slider" aria-label="Волна. Стрелки перемещают позицию по тактам" aria-valuemin="0" aria-valuenow="0"></canvas></div>
<div class="rangeRow"><span class="region">▧ &nbsp; ТАКТЫ</span><input aria-label="Первый такт" id="barA" type="number" min="1" value="3"><span>—</span><input aria-label="Последний такт" id="barB" type="number" min="1" value="4"><button id="repaint">↺ &nbsp; Repaint</button></div>
<div class="lyricRow"><span class="labInline">LYRIC CUE</span><div id="cue"></div></div></article>
<article class="panel mixer"><div class="cap"><span class="sectionNo">03</span><h2>Стем-микшер</h2><button class="capAction" id="resetMix">Сбросить</button></div><div class="strips" id="strips"></div><div class="mixerfoot"><span>● &nbsp; STEREO BUS</span><span id="sampleTag">32.0 kHz</span></div></article></section>
<aside class="right"><article class="panel"><div class="cap"><span class="sectionNo">04</span><h2>Mastering Rack</h2></div><div class="pad rackpad"><div class="vu"><canvas id="vu" aria-label="Аналоговый индикатор уровня"></canvas></div><div class="meters"><div><small>LUFS · M</small><b id="lufs">−∞</b></div><div><small>PEAK · dBFS</small><b id="pk">−∞</b></div></div><label class="lab">Мастер-пресет<select id="preset"><option value="-9.6">Streaming · −9.6 LUFS</option><option value="-7.5">Club / Hip-Hop · −7.5</option><option value="-14">Apple · −14.0 LUFS</option></select></label></div></article>
<article class="panel"><div class="cap"><span class="sectionNo">05</span><h2>Blind A/B Lab</h2></div><div class="pad labpad"><div class="ab"><button id="abA">A</button><button id="abB">B</button></div><div id="abInfo" class="hint">Сравнить два мастера при равной громкости.</div><div class="abLinks"><button id="abReveal">Раскрыть</button><button id="abRef">Загрузить B</button></div></div></article>
<article class="exports"><button id="exportPack">↓ &nbsp; 4-WAV Sync Pack <span>ZIP</span></button><button id="reel">▣ &nbsp; 35mm Reel <span>9:16</span></button><button id="cloudPanel" hidden>↗ &nbsp; Студия и лицензии</button></article></aside></div>
<footer><span id="status" role="status" aria-live="polite">Готово к воспроизведению</span><span>SAFAR STUDIO <b>/</b> V5.0</span></footer></main>
<dialog id="modal"><div class="dialogHead"><div><div class="eyebrow" id="dlgCap">SAFAR STUDIO</div><h2 id="dlgTitle"></h2></div><button class="icon" id="close" aria-label="Закрыть">×</button></div><div id="dlg"></div></dialog>
<input id="file" type="file" accept="audio/*,.wav,.mp3,.flac" hidden><script>/*__ENGINE__*/</script><script>/*__UI__*/</script><script>/*__CLOUD__*/</script></body></html>
